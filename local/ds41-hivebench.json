{
 "exe": "local/ds41-engine-local.sh",
 "args": [
  "-m",
  "models/V41-GSQ/V41-GSQ.gguf",
  "--backend",
  "cuda",
  "--experts",
  "gpu",
  "--rank",
  "models/V41-GSQ/rank.bin",
  "--threads",
  "12",
  "--pf-b",
  "0",
  "--ctx",
  "32768",
  "--stop",
  "1",
  "--kv-q8",
  "--prompt-batch",
  "2048",
  "--arena-gib",
  "4",
  "--engram",
  "models/engram/layers14:models/engram/layers1"
 ],
 "env": {
  "STRATA_NO_LARGEPAGES": "1",
  "STRATA_ADVISE_AHEAD": "6",
  "STRATA_DECODE_DIRECT": "0",
  "GGML_NO_BACKTRACE": "1",
  "GGML_CUDA_DISABLE_GRAPHS": "1",
  "STRATA_PRESTAGE_GIB": "1.5",
  "STRATA_SERVE_PASS_BIAS": "0",
  "DS41_EXE": "build-hip-pre/ds41_generate",
  "STRATA_SERVE_DSPARK": "models/V41-GSQ/V41-MTP-Vision.Q2_K.gguf",
  "STRATA_DSPARK_DEPTH": "4",
  "STRATA_DSPARK_KEEP": "tools/v41/serve/dspark_expert_counts.txt:64",
  "STRATA_TEXT_LOG": "local/v41-text.log",
  "STRATA_DENSE_REQUANT": "q4_K",
  "STRATA_ADVISE_PREV": "1"
 },
 "cwd": ".",
 "tokenizer": "models/V41-GSQ/tokenizer",
 "model_name": "deepseek-v4.1-flash-gsq",
 "log": "local/serve-engine.log",
 "port": 8150,
 "backend": "hip",
 "gpu": 0,
 "sampling": {
  "temperature": 1.0,
  "top_p": 0.95
 },
 "reasoning_loop_recovery": "recover",
 "reasoning_budget_tokens": 2048,
 "reasoning_close_retry": true
}
