# tools/v41/engine/v41_engine.cmake - the DeepSeek-V4.1 engine (Strata-DS4 fork; included from tools/ds4/cmake/fork.cmake).
set(_v41_dir ${CMAKE_CURRENT_SOURCE_DIR}/tools/v41/engine)
add_executable(test_ds41_geometry ${_v41_dir}/test_ds41_geometry.cpp)
target_include_directories(test_ds41_geometry PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/include ${_v41_dir})
if(TARGET ggml-cpu)
    if(STRATA_GGML_DIR)
        set(_v41_ggml_src ${STRATA_GGML_DIR}/ggml/src)
    else()
        set(_v41_ggml_src ${CMAKE_CURRENT_SOURCE_DIR}/third_party/llama.cpp/ggml/src)
    endif()
    add_library(ds41_dense STATIC ${_v41_dir}/ds41_dense.cpp ${_v41_dir}/ds41_engram.cpp)
    target_include_directories(ds41_dense PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include ${_v41_dir} PRIVATE ${_v41_ggml_src})
    target_link_libraries(ds41_dense PUBLIC ggml ggml-cpu ggml-base)
    if(TARGET ggml-cuda)
        target_link_libraries(ds41_dense PUBLIC ggml-cuda)
    endif()
endif()
if(TARGET ds41_dense AND TARGET strata_kernels_cpu)
    add_executable(test_ds41_dense ${_v41_dir}/test_ds41_dense.cpp)
    target_link_libraries(test_ds41_dense PRIVATE ds41_dense strata_kernels_cpu)
endif()
if(TARGET ds41_dense)
    add_executable(test_ds41_ops ${_v41_dir}/test_ds41_ops.cpp)
    target_link_libraries(test_ds41_ops PRIVATE ds41_dense)
endif()
# the Engram row-read bench (CPU + disk only): it compiles the module straight in, so it builds without ggml or CUDA
add_executable(bench_ds41_engram ${_v41_dir}/bench_ds41_engram.cpp ${_v41_dir}/ds41_engram.cpp)
target_include_directories(bench_ds41_engram PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/include ${_v41_dir})
find_package(Threads REQUIRED)
target_link_libraries(bench_ds41_engram PRIVATE Threads::Threads)
# the routed-expert tier with per-expert format classes (fork of tools/ds4/ds4_moe; CPU flavour + CUDA flavour)
if(TARGET strata_kernels_cpu AND TARGET ggml-cpu)
    add_library(ds41_moe_cpu STATIC ${_v41_dir}/ds41_moe.cpp)
    target_include_directories(ds41_moe_cpu PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include ${_v41_dir})
    target_link_libraries(ds41_moe_cpu PUBLIC strata_kernels_cpu strata_artifact ggml ggml-base)
    if(TARGET CUDA::cudart AND TARGET strata_kernels)
        add_library(ds41_moe_cuda STATIC ${_v41_dir}/ds41_moe.cpp)
        target_compile_definitions(ds41_moe_cuda PRIVATE DS4_MOE_CUDA=1)
        target_include_directories(ds41_moe_cuda PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include ${_v41_dir})
        target_link_libraries(ds41_moe_cuda PUBLIC strata_engine strata_kernels strata_kernels_cpu strata_artifact ggml
                                                   ggml-base CUDA::cudart)
        if(TARGET strata_mmq)
            target_compile_definitions(ds41_moe_cuda PRIVATE DS4_MOE_MMQ=1)
            target_link_libraries(ds41_moe_cuda PUBLIC strata_mmq)
        endif()
    endif()
endif()
# the end-to-end engine: CUDA tier when built, else the CPU-only tier
if(TARGET ds41_dense AND TARGET ds41_moe_cuda)
    add_executable(ds41_generate ${_v41_dir}/ds41_generate.cpp)
    target_link_libraries(ds41_generate PRIVATE ds41_dense ds41_moe_cuda)
elseif(TARGET ds41_dense AND TARGET ds41_moe_cpu)
    add_executable(ds41_generate ${_v41_dir}/ds41_generate.cpp)
    target_link_libraries(ds41_generate PRIVATE ds41_dense ds41_moe_cpu)
endif()
# the tier gate on real mixed-tier experts: CPU flavour (no CUDA call) and the CUDA flavour (--gpu)
if(TARGET ds41_moe_cpu)
    add_executable(test_ds41_moe ${_v41_dir}/test_ds41_moe.cpp)
    target_link_libraries(test_ds41_moe PRIVATE ds41_moe_cpu ggml-cpu)
endif()
if(TARGET ds41_moe_cuda)
    add_executable(test_ds41_moe_gpu ${_v41_dir}/test_ds41_moe.cpp)
    target_link_libraries(test_ds41_moe_gpu PRIVATE ds41_moe_cuda ggml-cpu)
    # fork slice xk-kernels: the prompt-batch (PROM) grouped kernels vs the native ones and a dequant+F32 reference,
    # on real expert blobs, at group sizes 1..1024 (drives native_expert_grouped directly)
    add_executable(test_ds41_prom ${_v41_dir}/test_ds41_prom.cpp)
    target_include_directories(test_ds41_prom PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/include ${_v41_dir} ${_strata_gpu_include_directories})
    target_link_libraries(test_ds41_prom PRIVATE ds41_moe_cuda strata_kernels ${_strata_gpu_runtime_target})
endif()
